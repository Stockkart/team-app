# Copy to .env (repository root) for local `expo start` / `expo prebuild`.
# EXPO_PUBLIC_* values are inlined into the bundle: never put a secret here.

# Must start with https:// — app.config.js refuses to build otherwise (R9.7).
EXPO_PUBLIC_API_URL=https://api.example.in/api/v1

# Google OAuth *web* client id (the one the web dashboard uses), so the ID token's audience is the
# one inventory-api accepts (design DD8). A client id is public; app.config.js only checks it is set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Optional: where the web dashboard lives, for the "Forgot password?" link (opens <web>/forgot-password
# in the browser). Leave unset when the web is served from the API URL's origin. Must be https:// when set.
# EXPO_PUBLIC_WEB_URL=https://stockkart.example.in
